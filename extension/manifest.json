{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.4.10",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "commands": {
    "toggle-bar": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Toggle multi-row bookmark bar"
    },
    "open-bookmark-1": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "__MSG_cmdOpenBookmark1__"
    },
    "open-bookmark-2": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "__MSG_cmdOpenBookmark2__"
    },
    "open-bookmark-3": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "__MSG_cmdOpenBookmark3__"
    },
    "open-bookmark-4": {
      "description": "__MSG_cmdOpenBookmark4__"
    },
    "open-bookmark-5": {
      "description": "__MSG_cmdOpenBookmark5__"
    },
    "open-bookmark-6": {
      "description": "__MSG_cmdOpenBookmark6__"
    },
    "open-bookmark-7": {
      "description": "__MSG_cmdOpenBookmark7__"
    },
    "open-bookmark-8": {
      "description": "__MSG_cmdOpenBookmark8__"
    },
    "open-bookmark-9": {
      "description": "__MSG_cmdOpenBookmark9__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "_locales/en/messages.json",
        "_locales/ja/messages.json",
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
